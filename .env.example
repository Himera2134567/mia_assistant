# Copy this file to .env and insert your own values.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
# Direct DeepSeek API. MIA tries it before OpenRouter when this key is present.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Automatic fallback order: direct DeepSeek, OpenRouter, built-in Qwen, then Ollama.
MIA_PROVIDER=auto
MIA_PROVIDER_ORDER=deepseek,openrouter,local,ollama
MIA_LOCAL_MODEL_PATH=models/llm/qwen2.5-3b-instruct-q4_k_m.gguf
OLLAMA_MODEL=qwen3:4b
# Optional: replace MIA's default persona with your own one-line system prompt.
MIA_SYSTEM_PROMPT=
# Optional custom location of the offline Russian Vosk model.
MIA_VOSK_MODEL_PATH=
# Accurate command transcription model (larger means slower but more accurate).
MIA_WHISPER_MODEL=large-v3-turbo

# Optional: required only for the built-in GitHub publishing tab.
GITHUB_TOKEN=
GITHUB_OWNER=
